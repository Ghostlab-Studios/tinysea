# Apache configuration (contains server-specific settings)
.htaccess

# Environment and secrets
.env
.env.*

# Unity WebGL build files (large binaries, built from Unity project)
builds/v*/TinySeaWebGL/Build/*.br
builds/v*/TinySeaWebGL/Build/*.wasm
builds/v*/TinySeaWebGL/Build/*.data
builds/v*/TinySeaWebGL/Build/*.js
builds/v*/TinySeaWebGL/TemplateData/

# Streaming assets
builds/v*/TinySeaWebGL/StreamingAssets/

# Standalone build archives (large binaries, uploaded directly via FileZilla)
builds/v*/*.zip

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE/editor
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and temp files
*.log
*.bak
*.tmp

# Diagnostic/debug tools (should not be in production)
diagnostic.html
